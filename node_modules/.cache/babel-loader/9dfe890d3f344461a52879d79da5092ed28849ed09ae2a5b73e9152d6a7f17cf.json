{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'LogisticsManagement',\n  data() {\n    return {\n      newDriver: '',\n      drivers: [],\n      newItem: '',\n      inventory: []\n    };\n  },\n  methods: {\n    addDriver() {\n      if (this.newDriver.trim()) {\n        this.drivers.push({\n          name: this.newDriver.trim(),\n          status: 'Available'\n        });\n        this.newDriver = '';\n      }\n    },\n    removeDriver(index) {\n      this.drivers.splice(index, 1);\n    },\n    addItem() {\n      if (this.newItem.trim()) {\n        this.inventory.push({\n          name: this.newItem.trim(),\n          quantity: 10\n        }); // Default quantity\n        this.newItem = '';\n      }\n    },\n    removeItem(index) {\n      this.inventory.splice(index, 1);\n    }\n  }\n};","map":{"version":3,"names":["name","data","newDriver","drivers","newItem","inventory","methods","addDriver","trim","push","status","removeDriver","index","splice","addItem","quantity","removeItem"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\views\\LogisticsManagement.vue"],"sourcesContent":["<template>\r\n    <div class=\"logistics-management\">\r\n      <h2>Logistics Management</h2>\r\n      <div class=\"drivers-section\">\r\n        <h3>Assign Drivers</h3>\r\n        <input v-model=\"newDriver\" placeholder=\"Add driver name\" @keyup.enter=\"addDriver\" />\r\n        <ul>\r\n          <li v-for=\"(driver, index) in drivers\" :key=\"index\">\r\n            {{ driver.name }} \r\n            <select v-model=\"driver.status\">\r\n              <option>Available</option>\r\n              <option>Assigned</option>\r\n              <option>Off Duty</option>\r\n            </select>\r\n            <button @click=\"removeDriver(index)\">Remove</button>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n      <div class=\"inventory-section\">\r\n        <h3>Inventory</h3>\r\n        <input v-model=\"newItem\" placeholder=\"Add inventory item\" @keyup.enter=\"addItem\" />\r\n        <ul>\r\n          <li v-for=\"(item, index) in inventory\" :key=\"index\">\r\n            {{ item.name }} - {{ item.quantity }} units\r\n            <button @click=\"removeItem(index)\">Remove</button>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: 'LogisticsManagement',\r\n    data() {\r\n      return {\r\n        newDriver: '',\r\n        drivers: [],\r\n        newItem: '',\r\n        inventory: [],\r\n      };\r\n    },\r\n    methods: {\r\n      addDriver() {\r\n        if (this.newDriver.trim()) {\r\n          this.drivers.push({ name: this.newDriver.trim(), status: 'Available' });\r\n          this.newDriver = '';\r\n        }\r\n      },\r\n      removeDriver(index) {\r\n        this.drivers.splice(index, 1);\r\n      },\r\n      addItem() {\r\n        if (this.newItem.trim()) {\r\n          this.inventory.push({ name: this.newItem.trim(), quantity: 10 }); // Default quantity\r\n          this.newItem = '';\r\n        }\r\n      },\r\n      removeItem(index) {\r\n        this.inventory.splice(index, 1);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .logistics-management {\r\n    padding: 20px;\r\n    background-color: #f9f9f9;\r\n    min-height: 100vh;\r\n  }\r\n  h2 {\r\n    color: #333;\r\n  }\r\n  .drivers-section, .inventory-section {\r\n    margin-top: 20px;\r\n  }\r\n  h3 {\r\n    font-size: 18px;\r\n    color: #555;\r\n    margin-bottom: 10px;\r\n  }\r\n  input {\r\n    width: 200px;\r\n    padding: 5px;\r\n    margin-bottom: 10px;\r\n  }\r\n  ul {\r\n    list-style: none;\r\n    padding: 0;\r\n  }\r\n  li {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 5px 0;\r\n  }\r\n  select {\r\n    padding: 5px;\r\n  }\r\n  button {\r\n    padding: 5px 10px;\r\n    background-color: #ff4d4d;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 3px;\r\n    cursor: pointer;\r\n  }\r\n  button:hover {\r\n    background-color: #e60000;\r\n  }\r\n  </style>"],"mappings":";AAgCE,eAAe;EACbA,IAAI,EAAE,qBAAqB;EAC3BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,EAAE;MACXC,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,SAASA,CAAA,EAAG;MACV,IAAI,IAAI,CAACL,SAAS,CAACM,IAAI,CAAC,CAAC,EAAE;QACzB,IAAI,CAACL,OAAO,CAACM,IAAI,CAAC;UAAET,IAAI,EAAE,IAAI,CAACE,SAAS,CAACM,IAAI,CAAC,CAAC;UAAEE,MAAM,EAAE;QAAY,CAAC,CAAC;QACvE,IAAI,CAACR,SAAQ,GAAI,EAAE;MACrB;IACF,CAAC;IACDS,YAAYA,CAACC,KAAK,EAAE;MAClB,IAAI,CAACT,OAAO,CAACU,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IAC/B,CAAC;IACDE,OAAOA,CAAA,EAAG;MACR,IAAI,IAAI,CAACV,OAAO,CAACI,IAAI,CAAC,CAAC,EAAE;QACvB,IAAI,CAACH,SAAS,CAACI,IAAI,CAAC;UAAET,IAAI,EAAE,IAAI,CAACI,OAAO,CAACI,IAAI,CAAC,CAAC;UAAEO,QAAQ,EAAE;QAAG,CAAC,CAAC,EAAE;QAClE,IAAI,CAACX,OAAM,GAAI,EAAE;MACnB;IACF,CAAC;IACDY,UAAUA,CAACJ,KAAK,EAAE;MAChB,IAAI,CAACP,SAAS,CAACQ,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IACjC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}