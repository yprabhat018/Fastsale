displayAlertsOnMap();\r\n      },\r\n      displayAlertsOnMap() {\r\n        console.log('Displaying alerts on map:', this.alerts);\r\n        this.alerts.forEach((alert) => {\r\n          console.log('Adding marker for:', alert.type, alert.location);\r\n          new this.$google.maps.Marker({\r\n            position: alert.location,\r\n            map: this.map,\r\n            title: alert.type,\r\n            icon: alert.type === 'Accident'\r\n              ? 'http://maps.google.com/mapfiles/ms/icons/red-dot.png'\r\n              : 'http://maps.google.com/mapfiles/ms/icons/orange-dot.png',\r\n          });\r\n        });\r\n      },\r\n      reportIssue() {\r\n        console.log('Report Issue clicked!');\r\n        const newAlert = {\r\n          id: this.alerts.length + 1,\r\n          type: 'Accident',\r\n          location: { lat: 37.7749, lng: -122.4194 },\r\n          timestamp: new Date(),\r\n        };\r\n        this.alerts.push(newAlert);\r\n        console.log('New alert added:', newAlert);\r\n        localStorage.setItem('alerts', JSON.stringify(this.alerts));\r\n        this.displayAlertsOnMap();\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .crowdsourced-alerts {\r\n    padding: 20px;\r\n    background-color: #fff0f5;\r\n    min-height: 100vh;\r\n  }\r\n  h2 {\r\n    color: #333;\r\n    margin-bottom: 10px;\r\n  }\r\n  #map {\r\n    height: 400px;\r\n    width: 100%;\r\n    border: 1px solid #ccc;\r\n    margin-bottom: 10px;\r\n  }\r\n  button {\r\n    padding: 8px 16px;\r\n    background-color: #ff5722;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 3px;\r\n    cursor: pointer;\r\n  }\r\n  button:hover {\r\n    background-color: #e64a19;\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAqB;;uBAAhCC,mBAAA,CAIM,OAJNC,UAIM,G,0BAHJC,mBAAA,CAAqC,YAAjC,8BAA4B,sB,0BAChCA,mBAAA,CAAoB;IAAfC,EAAE,EAAC;EAAK,6BACbD,mBAAA,CAAkD;IAAzCE,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,WAAA,IAAAD,QAAA,CAAA