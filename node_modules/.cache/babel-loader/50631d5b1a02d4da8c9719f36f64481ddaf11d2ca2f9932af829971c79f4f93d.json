{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'ShippingTracking',\n  data() {\n    return {\n      newOrder: '',\n      orders: [{\n        id: 'ABC123',\n        status: 'Pending',\n        location: 'Warehouse'\n      }, {\n        id: 'XYZ789',\n        status: 'Shipped',\n        location: 'City A'\n      }, {\n        id: 'DEF456',\n        status: 'In Transit',\n        location: 'City B'\n      }],\n      statuses: ['Pending', 'Shipped', 'In Transit', 'Delivered'],\n      locations: ['Warehouse', 'City A', 'City B', 'Destination']\n    };\n  },\n  methods: {\n    addOrder() {\n      if (this.newOrder.trim()) {\n        this.orders.push({\n          id: this.newOrder.trim(),\n          status: 'Pending',\n          location: 'Warehouse'\n        });\n        this.newOrder = '';\n      }\n    },\n    updateOrderStatus(index) {\n      const currentStatusIndex = this.statuses.indexOf(this.orders[index].status);\n      const nextStatusIndex = (currentStatusIndex + 1) % this.statuses.length;\n      this.orders[index].status = this.statuses[nextStatusIndex];\n      this.orders[index].location = this.locations[nextStatusIndex];\n    },\n    removeOrder(index) {\n      this.orders.splice(index, 1);\n    }\n  }\n};","map":{"version":3,"names":["name","data","newOrder","orders","id","status","location","statuses","locations","methods","addOrder","trim","push","updateOrderStatus","index","currentStatusIndex","indexOf","nextStatusIndex","length","removeOrder","splice"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\views\\ShippingTracking.vue"],"sourcesContent":["<template>\r\n    <div class=\"shipping-tracking\">\r\n      <h2>Shipping Tracking</h2>\r\n      <div class=\"tracking-section\">\r\n        <h3>Track Shipments</h3>\r\n        <input v-model=\"newOrder\" placeholder=\"Add order ID (e.g., XYZ789)\" @keyup.enter=\"addOrder\" />\r\n        <ul>\r\n          <li v-for=\"(order, index) in orders\" :key=\"index\">\r\n            Order {{ order.id }} - Status: {{ order.status }} - Location: {{ order.location }}\r\n            <button @click=\"updateOrderStatus(index)\">Update Status</button>\r\n            <button @click=\"removeOrder(index)\">Remove</button>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: 'ShippingTracking',\r\n    data() {\r\n      return {\r\n        newOrder: '',\r\n        orders: [\r\n          { id: 'ABC123', status: 'Pending', location: 'Warehouse' },\r\n          { id: 'XYZ789', status: 'Shipped', location: 'City A' },\r\n          { id: 'DEF456', status: 'In Transit', location: 'City B' },\r\n        ],\r\n        statuses: ['Pending', 'Shipped', 'In Transit', 'Delivered'],\r\n        locations: ['Warehouse', 'City A', 'City B', 'Destination'],\r\n      };\r\n    },\r\n    methods: {\r\n      addOrder() {\r\n        if (this.newOrder.trim()) {\r\n          this.orders.push({\r\n            id: this.newOrder.trim(),\r\n            status: 'Pending',\r\n            location: 'Warehouse',\r\n          });\r\n          this.newOrder = '';\r\n        }\r\n      },\r\n      updateOrderStatus(index) {\r\n        const currentStatusIndex = this.statuses.indexOf(this.orders[index].status);\r\n        const nextStatusIndex = (currentStatusIndex + 1) % this.statuses.length;\r\n        this.orders[index].status = this.statuses[nextStatusIndex];\r\n        this.orders[index].location = this.locations[nextStatusIndex];\r\n      },\r\n      removeOrder(index) {\r\n        this.orders.splice(index, 1);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .shipping-tracking {\r\n    padding: 20px;\r\n    background-color: #f0f8ff;\r\n    min-height: 100vh;\r\n  }\r\n  h2 {\r\n    color: #333;\r\n  }\r\n  .tracking-section {\r\n    margin-top: 20px;\r\n  }\r\n  h3 {\r\n    font-size: 18px;\r\n    color: #555;\r\n    margin-bottom: 10px;\r\n  }\r\n  input {\r\n    width: 200px;\r\n    padding: 5px;\r\n    margin-bottom: 10px;\r\n  }\r\n  ul {\r\n    list-style: none;\r\n    padding: 0;\r\n  }\r\n  li {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 5px 0;\r\n  }\r\n  button {\r\n    padding: 5px 10px;\r\n    background-color: #007bff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 3px;\r\n    cursor: pointer;\r\n  }\r\n  button:hover {\r\n    background-color: #0056b3;\r\n  }\r\n  button:nth-child(2) {\r\n    background-color: #ff4d4d;\r\n  }\r\n  button:nth-child(2):hover {\r\n    background-color: #e60000;\r\n  }\r\n  </style>"],"mappings":";AAkBE,eAAe;EACbA,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE,CACN;QAAEC,EAAE,EAAE,QAAQ;QAAEC,MAAM,EAAE,SAAS;QAAEC,QAAQ,EAAE;MAAY,CAAC,EAC1D;QAAEF,EAAE,EAAE,QAAQ;QAAEC,MAAM,EAAE,SAAS;QAAEC,QAAQ,EAAE;MAAS,CAAC,EACvD;QAAEF,EAAE,EAAE,QAAQ;QAAEC,MAAM,EAAE,YAAY;QAAEC,QAAQ,EAAE;MAAS,CAAC,CAC3D;MACDC,QAAQ,EAAE,CAAC,SAAS,EAAE,SAAS,EAAE,YAAY,EAAE,WAAW,CAAC;MAC3DC,SAAS,EAAE,CAAC,WAAW,EAAE,QAAQ,EAAE,QAAQ,EAAE,aAAa;IAC5D,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,QAAQA,CAAA,EAAG;MACT,IAAI,IAAI,CAACR,QAAQ,CAACS,IAAI,CAAC,CAAC,EAAE;QACxB,IAAI,CAACR,MAAM,CAACS,IAAI,CAAC;UACfR,EAAE,EAAE,IAAI,CAACF,QAAQ,CAACS,IAAI,CAAC,CAAC;UACxBN,MAAM,EAAE,SAAS;UACjBC,QAAQ,EAAE;QACZ,CAAC,CAAC;QACF,IAAI,CAACJ,QAAO,GAAI,EAAE;MACpB;IACF,CAAC;IACDW,iBAAiBA,CAACC,KAAK,EAAE;MACvB,MAAMC,kBAAiB,GAAI,IAAI,CAACR,QAAQ,CAACS,OAAO,CAAC,IAAI,CAACb,MAAM,CAACW,KAAK,CAAC,CAACT,MAAM,CAAC;MAC3E,MAAMY,eAAc,GAAI,CAACF,kBAAiB,GAAI,CAAC,IAAI,IAAI,CAACR,QAAQ,CAACW,MAAM;MACvE,IAAI,CAACf,MAAM,CAACW,KAAK,CAAC,CAACT,MAAK,GAAI,IAAI,CAACE,QAAQ,CAACU,eAAe,CAAC;MAC1D,IAAI,CAACd,MAAM,CAACW,KAAK,CAAC,CAACR,QAAO,GAAI,IAAI,CAACE,SAAS,CAACS,eAAe,CAAC;IAC/D,CAAC;IACDE,WAAWA,CAACL,KAAK,EAAE;MACjB,IAAI,CAACX,MAAM,CAACiB,MAAM,CAACN,KAAK,EAAE,CAAC,CAAC;IAC9B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}