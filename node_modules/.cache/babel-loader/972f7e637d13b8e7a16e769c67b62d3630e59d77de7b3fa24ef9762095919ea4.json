{\r\n            position: alert.location,\r\n            map: this.map,\r\n            title: alert.type,\r\n          });\r\n        });\r\n      },\r\n      reportIssue() {\r\n        // Add a new alert (mock data for now)\r\n        const newAlert = {\r\n          type: \"Accident\",\r\n          location: { lat: 37.7749, lng: -122.4194 },\r\n          timestamp: new Date(),\r\n        };\r\n        this.alerts.push(newAlert);\r\n        localStorage.setItem(\"alerts\", JSON.stringify(this.alerts));\r\n        this.displayAlertsOnMap();\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style>\r\n  #map {\r\n    height: 400px;\r\n    width: 100%;\r\n  }\r\n  </style>"],"mappings":";;uBACIA,mBAAA,CAIM,c,0BAHJC,mBAAA,CAAqC,YAAjC,8BAA4B,sB,0BAChCA,mBAAA,CAAoB;IAAfC,EAAE,EAAC;EAAK,6BACbD,mBAAA,CAAkD;IAAzCE,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,WAAA,IAAAD,QAAA,CAAAC,WAAA,IAAAF,IAAA,CAAW;KAAE,cAAY,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}