{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  data() {\n    return {\n      map: null,\n      alerts: [] // Store alert data\n    };\n  },\n  mounted() {\n    // Initialize the Google Map\n    this.map = new google.maps.Map(document.getElementById(\"map\"), {\n      center: {\n        lat: 37.7749,\n        lng: -122.4194\n      },\n      // Default center (e.g., San Francisco)\n      zoom: 12\n    });\n    // Load any existing alerts\n    this.loadAlerts();\n  },\n  methods: {\n    loadAlerts() {\n      // Load alerts from local storage (for simplicity)\n      this.alerts = JSON.parse(localStorage.getItem(\"alerts\")) || [];\n      this.displayAlertsOnMap();\n    },\n    displayAlertsOnMap() {\n      // Add markers for each alert on the map\n      this.alerts.forEach(alert => {\n        new google.maps.Marker({\n          position: alert.location,\n          map: this.map,\n          title: alert.type\n        });\n      });\n    },\n    reportIssue() {\n      // Add a new alert (mock data for now)\n      const newAlert = {\n        type: \"Accident\",\n        location: {\n          lat: 37.7749,\n          lng: -122.4194\n        },\n        timestamp: new Date()\n      };\n      this.alerts.push(newAlert);\n      localStorage.setItem(\"alerts\", JSON.stringify(this.alerts));\n      this.displayAlertsOnMap();\n    }\n  }\n};","map":{"version":3,"names":["data","map","alerts","mounted","google","maps","Map","document","getElementById","center","lat","lng","zoom","loadAlerts","methods","JSON","parse","localStorage","getItem","displayAlertsOnMap","forEach","alert","Marker","position","location","title","type","reportIssue","newAlert","timestamp","Date","push","setItem","stringify"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\views\\CrowdsourcedAlerts.vue"],"sourcesContent":["<template>\r\n    <div>\r\n      <h2>Crowdsourced Delivery Alerts</h2>\r\n      <div id=\"map\"></div>\r\n      <button @click=\"reportIssue\">Report Issue</button>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    data() {\r\n      return {\r\n        map: null,\r\n        alerts: [], // Store alert data\r\n      };\r\n    },\r\n    mounted() {\r\n      // Initialize the Google Map\r\n      this.map = new google.maps.Map(document.getElementById(\"map\"), {\r\n        center: { lat: 37.7749, lng: -122.4194 }, // Default center (e.g., San Francisco)\r\n        zoom: 12,\r\n      });\r\n      // Load any existing alerts\r\n      this.loadAlerts();\r\n    },\r\n    methods: {\r\n      loadAlerts() {\r\n        // Load alerts from local storage (for simplicity)\r\n        this.alerts = JSON.parse(localStorage.getItem(\"alerts\")) || [];\r\n        this.displayAlertsOnMap();\r\n      },\r\n      displayAlertsOnMap() {\r\n        // Add markers for each alert on the map\r\n        this.alerts.forEach((alert) => {\r\n          new google.maps.Marker({\r\n            position: alert.location,\r\n            map: this.map,\r\n            title: alert.type,\r\n          });\r\n        });\r\n      },\r\n      reportIssue() {\r\n        // Add a new alert (mock data for now)\r\n        const newAlert = {\r\n          type: \"Accident\",\r\n          location: { lat: 37.7749, lng: -122.4194 },\r\n          timestamp: new Date(),\r\n        };\r\n        this.alerts.push(newAlert);\r\n        localStorage.setItem(\"alerts\", JSON.stringify(this.alerts));\r\n        this.displayAlertsOnMap();\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style>\r\n  #map {\r\n    height: 400px;\r\n    width: 100%;\r\n  }\r\n  </style>"],"mappings":";;;;AASE,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,GAAG,EAAE,IAAI;MACTC,MAAM,EAAE,EAAE,CAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,IAAI,CAACF,GAAE,GAAI,IAAIG,MAAM,CAACC,IAAI,CAACC,GAAG,CAA