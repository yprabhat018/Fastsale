{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null // To store the map object\n    };\n  },\n  mounted() {\n    // Use the global $google object\n    if (this.$google) {\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\n        center: {\n          lat: 37.7749,\n          lng: -122.4194\n        },\n        // San Francisco\n        zoom: 12\n      });\n    } else {\n      console.error('Google Maps not loaded yet!');\n    }\n  },\n  methods: {\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    }\n  }\n};","map":{"version":3,"names":["name","data","start","end","vehicle","map","mounted","$google","maps","Map","document","getElementById","center","lat","lng","zoom","console","error","methods","calculateRoute","log"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // To store the map object\n    };\n  },\n  mounted() {\n    // Use the global $google object\n    if (this.$google) {\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    } else {\n      console.error('Google Maps not loaded yet!');\n    }\n  },\n  methods: {\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput, select, button {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style>\n<!-- <template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Loader } from '@googlemaps/js-api-loader';\n\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // Store the map here\n    };\n  },\n  mounted() {\n    // Load Google Maps when the component mounts\n    const loader = new Loader({\n      apiKey: 'AIzaSyCOrCd4askrLzy3Ml2LGzsX1a1pHmuLC6k', // Replace with your Google Maps API key\n      version: 'weekly',\n      libraries: ['places'],\n    });\n\n    loader.load().then(() => {\n      console.log('Google Maps loaded in App.vue');\n      this.map = new google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    }).catch(error => {\n      console.error('Error loading Google Maps:', error);\n    });\n  },\n  methods: {\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput, select, button {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style> -->\n<!-- \n\n<template>\n  <div id=\"app\">\n    <h1>Hello, Logistics App!</h1>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n};\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  text-align: center;\n}\n</style> --> \n\n<!-- <template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // To store the map object\n    };\n  },\n  mounted() {\n    // Wait for Google Maps to load\n    if (window.google) {\n      this.initMap();\n    } else {\n      const checkGoogle = setInterval(() => {\n        if (window.google) {\n          clearInterval(checkGoogle);\n          this.initMap();\n        }\n      }, 100);\n    }\n  },\n  methods: {\n    initMap() {\n      // Create the map once Google is ready\n      this.map = new window.google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    },\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput,\nselect,\nbutton {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style>  -->\n<!-- <template>\n  <img alt=\"Vue logo\" src=\"./assets/logo.png\">\n  <HelloWorld msg=\"Welcome to Your Vue.js App\"/>\n</template>\n\n<script>\nimport HelloWorld from './components/HelloWorld.vue'\n\nexport default {\n  name: 'App',\n  components: {\n    HelloWorld\n  }\n}\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n</style>-->\n"],"mappings":";;AAmBA,eAAe;EACbA,IAAI,EAAE,KAAK;EACXC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,GAAG,EAAE,EAAE;MACPC,OAAO,EAAE,KAAK;MACdC,GAAG,EAAE,IAAI,CAAE;IACb,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,IAAI,IAAI,CAACC,OAAO,EAAE;MAChB,IAAI,CAACF,GAAE,GAAI,IAAI,IAAI,CAACE,OAAO,CAACC,IAAI,CAACC,GAAG,CAACC,QAAQ,CAACC,cAAc,CAAC,KAAK,CAAC,EAAE;QACnEC,MAAM,EAAE;UAAEC,GAAG,EAAE,OAAO;UAAEC,GAAG,EAAE,CAAC;QAAS,CAAC;QAAE;QAC1CC,IAAI,EAAE;MACR,CAAC,CAAC;IACJ,OAAO;MACLC,OAAO,CAACC,KAAK,CAAC,6BAA6B,CAAC;IAC9C;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,cAAcA,CAAA,EAAG;MACfH,OAAO,CAACI,GAAG,CAAC,wBAAwB,EAAE,IAAI,CAAClB,KAAK,EAAE,IAAI,EAAE,IAAI,CAACC,GAAG,EAAE,MAAM,EAAE,IAAI,CAACC,OAAO,CAAC;IACzF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}