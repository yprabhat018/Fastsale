{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'CrowdsourcedAlerts',\n  data() {\n    return {\n      map: null,\n      alerts: []\n    };\n  },\n  mounted() {\n    if (this.$google) {\n      console.log('Google Maps API loaded, initializing map...');\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\n        center: {\n          lat: 37.7749,\n          lng: -122.4194\n        },\n        zoom: 12\n      });\n      this.loadAlerts();\n    } else {\n      console.error('Google Maps API not loaded!');\n    }\n  },\n  methods: {\n    loadAlerts() {\n      console.log('Loading alerts...');\n      this.alerts = JSON.parse(localStorage.getItem('alerts')) || [];\n      this.displayAlertsOnMap();\n    },\n    displayAlertsOnMap() {\n      console.log('Displaying alerts on map:', this.alerts);\n      this.alerts.forEach(alert => {\n        console.log('Adding marker for:', alert.type, alert.location);\n        new this.$google.maps.Marker({\n          position: alert.location,\n          map: this.map,\n          title: alert.type,\n          icon: alert.type === 'Accident' ? 'http://maps.google.com/mapfiles/ms/icons/red-dot.png' : 'http://maps.google.com/mapfiles/ms/icons/orange-dot.png'\n        });\n      });\n    },\n    reportIssue() {\n      console.log('Report Issue clicked!');\n      const newAlert = {\n        id: this.alerts.length + 1,\n        type: 'Accident',\n        location: {\n          lat: 37.7749,\n          lng: -122.4194\n        },\n        timestamp: new Date()\n      };\n      this.alerts.push(newAlert);\n      console.log('New alert added:', newAlert);\n      localStorage.setItem('alerts', JSON.stringify(this.alerts));\n      this.displayAlertsOnMap();\n    }\n  }\n};","map":{"version":3,"names":["name","data","map","alerts","mounted","$google","console","log","maps","Map","document","getElementById","center","lat","lng","zoom","loadAlerts","error","methods","JSON","parse","localStorage","getItem","displayAlertsOnMap","forEach","alert","type","location","Marker","position","title","icon","reportIssue","newAlert","id","length","timestamp","Date","push","setItem","stringify"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\views\\CrowdsourcedAlerts.vue"],"sourcesContent":["<template>\r\n    <div class=\"crowdsourced-alerts\">\r\n      <h2>Crowdsourced Delivery Alerts</h2>\r\n      <div id=\"map\"></div>\r\n      <!-- <button @click=\"reportIssue\">Report Issue</button> -->\r\n      <button @click=\"reportIssue\">Report Issue</button>\r\n<!-- Add this temporarily -->\r\n<button @click=\"console.log('Test click')\">Test Click</button>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: 'CrowdsourcedAlerts',\r\n    data() {\r\n      return {\r\n        map: null,\r\n        alerts: [],\r\n      };\r\n    },\r\n    mounted() {\r\n      if (this.$google) {\r\n        console.log('Google Maps API loaded, initializing map...');\r\n        this.map = new this.$google.maps.Map(document.getElementById('map'), {\r\n          center: { lat: 37.7749, lng: -122.4194 },\r\n          zoom: 12,\r\n        });\r\n        this.loadAlerts();\r\n      } else {\r\n        console.error('Google Maps API not loaded!');\r\n      }\r\n    },\r\n    methods: {\r\n      loadAlerts() {\r\n        console.log('Loading alerts...');\r\n        this.alerts = JSON.parse(localStorage.getItem('alerts')) || [];\r\n        this.displayAlertsOnMap();\r\n      },\r\n      displayAlertsOnMap() {\r\n        console.log('Displaying alerts on map:', this.alerts);\r\n        this.alerts.forEach((alert) => {\r\n          console.log('Adding marker for:', alert.type, alert.location);\r\n          new this.$google.maps.Marker({\r\n            position: alert.location,\r\n            map: this.map,\r\n            title: alert.type,\r\n            icon: alert.type === 'Accident'\r\n              ? 'http://maps.google.com/mapfiles/ms/icons/red-dot.png'\r\n              : 'http://maps.google.com/mapfiles/ms/icons/orange-dot.png',\r\n          });\r\n        });\r\n      },\r\n      reportIssue() {\r\n        console.log('Report Issue clicked!');\r\n        const newAlert = {\r\n          id: this.alerts.length + 1,\r\n          type: 'Accident',\r\n          location: { lat: 37.7749, lng: -122.4194 },\r\n          timestamp: new Date(),\r\n        };\r\n        this.alerts.push(newAlert);\r\n        console.log('New alert added:', newAlert);\r\n        localStorage.setItem('alerts', JSON.stringify(this.alerts));\r\n        this.displayAlertsOnMap();\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .crowdsourced-alerts {\r\n    padding: 20px;\r\n    background-color: #fff0f5;\r\n    min-height: 100vh;\r\n  }\r\n  h2 {\r\n    color: #333;\r\n    margin-bottom: 10px;\r\n  }\r\n  #map {\r\n    height: 400px;\r\n    width: 100%;\r\n    border: 1px solid #ccc;\r\n    margin-bottom: 10px;\r\n  }\r\n  button {\r\n    padding: 8px 16px;\r\n    background-color: #ff5722;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 3px;\r\n    cursor: pointer;\r\n  }\r\n  button:hover {\r\n    background-color: #e64a19;\r\n  }\r\n  </style>"],"mappings":";;;;AAYE,eAAe;EACbA,IAAI,EAAE,oBAAoB;EAC1BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,GAAG,EAAE,IAAI;MACTC,MAAM,EAAE;IACV,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,IAAI,CAACC,OAAO,EAAE;MAChBC,OAAO,CAACC,GAAG,CAAC,6CAA6C,CAAC;MAC1D,IAAI,CAACL,GAAE,GAAI,IAAI,IAAI,CAACG,OAAO,CAACG,IAAI,CAACC,GAAG,CAACC,QAAQ,CAACC,cAAc,CAAC,KAAK,CAAC,EAAE;QACnEC,MAAM,EAAE;UAAEC,GAAG,EAAE,OAAO;UAAEC,GAAG,EAAE,CAAC;QAAS,CAAC;QACxCC,IAAI,EAAE;MACR,CAAC,CAAC;MACF,IAAI,CAACC,UAAU,CAAC,CAAC;IACnB,OAAO;MACLV,OAAO,CAACW,KAAK,CAAC,6BAA6B,CAAC;IAC9C;EACF,CAAC;EACDC,OAAO,EAAE;IACPF,UAAUA,CAAA,EAAG;MACXV,OAAO,CAACC,GAAG,CAAC,mBAA