{"ast":null,"code":"export default {\n  name: 'App'\n};","map":{"version":3,"names":["name"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <router-view></router-view>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n};\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n}\n</style>\n\n<!-- <template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // Store the map\n      directionsService: null, // To calculate routes\n      directionsRenderer: null, // To draw routes\n    };\n  },\n  mounted() {\n    if (this.$google) {\n      // Set up the map\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n      // Set up Directions Service and Renderer\n      this.directionsService = new this.$google.maps.DirectionsService();\n      this.directionsRenderer = new this.$google.maps.DirectionsRenderer();\n      this.directionsRenderer.setMap(this.map); // Link renderer to the map\n    } else {\n      console.error('Google Maps not loaded yet!');\n    }\n  },\n  methods: {\n    calculateRoute() {\n      if (!this.start || !this.end) {\n        alert('Please enter both start and end locations!');\n        return;\n      }\n\n      // Create a request for the Directions Service\n      const request = {\n        origin: this.start,\n        destination: this.end,\n        travelMode: 'DRIVING', // We’ll tweak this based on vehicle later\n      };\n\n      // Use Directions Service to get the route\n      this.directionsService.route(request, (result, status) => {\n        if (status === 'OK') {\n          // Draw the route on the map\n          this.directionsRenderer.setDirections(result);\n          console.log('Route drawn successfully!');\n        } else {\n          console.error('Error finding route:', status);\n          alert('Couldn’t find a route. Try different locations!');\n        }\n      });\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput,\nselect,\nbutton {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style> -->\n\n<!-- <template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // To store the map object\n    };\n  },\n  mounted() {\n    // Use the global $google object\n    if (this.$google) {\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    } else {\n      console.error('Google Maps not loaded yet!');\n    }\n  },\n  methods: {\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput, select, button {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style> -->\n<!-- <template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Loader } from '@googlemaps/js-api-loader';\n\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // Store the map here\n    };\n  },\n  mounted() {\n    // Load Google Maps when the component mounts\n    const loader = new Loader({\n      apiKey: 'AIzaSyCOrCd4askrLzy3Ml2LGzsX1a1pHmuLC6k', // Replace with your Google Maps API key\n      version: 'weekly',\n      libraries: ['places'],\n    });\n\n    loader.load().then(() => {\n      console.log('Google Maps loaded in App.vue');\n      this.map = new google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    }).catch(error => {\n      console.error('Error loading Google Maps:', error);\n    });\n  },\n  methods: {\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput, select, button {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style> -->\n<!-- \n\n<template>\n  <div id=\"app\">\n    <h1>Hello, Logistics App!</h1>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n};\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  text-align: center;\n}\n</style> --> \n\n<!-- <template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // To store the map object\n    };\n  },\n  mounted() {\n    // Wait for Google Maps to load\n    if (window.google) {\n      this.initMap();\n    } else {\n      const checkGoogle = setInterval(() => {\n        if (window.google) {\n          clearInterval(checkGoogle);\n          this.initMap();\n        }\n      }, 100);\n    }\n  },\n  methods: {\n    initMap() {\n      // Create the map once Google is ready\n      this.map = new window.google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    },\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput,\nselect,\nbutton {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style>  -->\n<!-- <template>\n  <img alt=\"Vue logo\" src=\"./assets/logo.png\">\n  <HelloWorld msg=\"Welcome to Your Vue.js App\"/>\n</template>\n\n<script>\nimport HelloWorld from './components/HelloWorld.vue'\n\nexport default {\n  name: 'App',\n  components: {\n    HelloWorld\n  }\n}\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n</style>-->\n"],"mappings":"AAOA,eAAe;EACbA,IAAI,EAAE;AACR,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}