) + \" kg\", 1 /* TEXT */), _createElementVNode(\"p\", null, \"Estimated Cost: ₹\" + _toDisplayString(($data.fuelUsed * $data.costRate).toFixed(2)), 1 /* TEXT */), _withDirectives(_createElementVNode(\"input\", {\n    type: \"text\",\n    \"onUpdate:modelValue\": _cache[10] || (_cache[10] = $event => $data.routeNotes = $event),\n    placeholder: \"Add route notes...\",\n    maxlength: \"100\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $data.routeNotes]]), _createElementVNode(\"button\", {\n    onClick: _cache[11] || (_cache[11] = (...args) => $options.saveRoute && $options.saveRoute(...args)),\n    disabled: $data.isSaving\n  }, [!$data.isSaving ? (_openBlock(), _createElementBlock(\"span\", _hoisted_17, \"Save Route\")) : (_openBlock(), _createElementBlock(\"span\", _hoisted_18))], 8 /* PROPS */, _hoisted_16), _createElementVNode(\"button\", {\n    onClick: _cache[12] || (_cache[12] = (...args) => $options.copyShareLink && $options.copyShareLink(...args)),\n    disabled: $data.isCopying\n  }, [!$data.isCopying ? (_openBlock(), _createElementBlock(\"span\", _hoisted_20, \"Copy Link\")) : (_openBlock(), _createElementBlock(\"span\", _hoisted_21))], 8 /* PROPS */, _hoisted_19)])) : _createCommentVNode(\"v-if\", true), $data.startWeather && $data.endWeather ? (_openBlock(), _createElementBlock(\"div\", _hoisted_22, [_cache[17] || (_cache[17] = _createElementVNode(\"h3\", null, \"Weather Conditions\", -1 /* HOISTED */)), _createElementVNode(\"p\", null, \"Start: \" + _toDisplayString($data.startWeather.weather[0].description) + \", \" + _toDisplayString($data.startWeather.main.temp) + \"°C\", 1 /* TEXT */), _createElementVNode(\"p\", null, \"End: \" + _toDisplayString($data.endWeather.weather[0].description) + \", \" + _toDisplayString($data.endWeather.main.temp) + \"°C\", 1 /* TEXT */)])) : _createCommentVNode(\"v-if\", true)])]);\n}","map":{"version":3,"names":["id","class","key","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","$data","savedRoutes","length","_hoisted_3","_Fragment","_renderList","route","index","_hoisted_4","onClick","$event","$options","loadSavedRoute","summary","_toDisplayString","start","end","adjustedDuration","toFixed","cost","_hoisted_5","type","notes","onBlur","_cache","args","updateNotes","placeholder","maxlength","_hoisted_6","deleteRoute","disabled","isDeleting","_hoisted_8","_hoisted_9","_hoisted_7","_createCommentVNode","vehicle","value","optimization","calculateRoute","isLoading","_hoisted_11","_hoisted_12","_hoisted_10","costRate","step","min","number","timeAdjustment","routes","_hoisted_13","selectedRoute","onChange","selectRoute","_hoisted_14","duration","distance","co2","_hoisted_15","fuelUsed","co2Emitted","routeNotes","saveRoute","isSaving","_hoisted_17","_hoisted_18","_hoisted_16","copyShareLink","isCopying","_hoisted_20","_hoisted_21","_hoisted_19","startWeather","endWeather","_hoisted_22","weather","description","main","temp"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\views\\RoutePlanner.vue"],"sourcesContent":["<!-- <template>\r\n  <div id=\"route-planner\">\r\n    <div class=\"map-container\">\r\n      <div id=\"map\"></div>\r\n    </div>\r\n    <div class=\"control-panel\">\r\n      <div class=\"saved-routes\" v-if=\"savedRoutes.length > 0\">\r\n        <h3>Saved Routes</h3>\r\n        <div v-for=\"(route, index) in savedRoutes\" :key=\"index\" class=\"saved-route\">\r\n          <div class=\"saved-route-info\">\r\n            <p @click=\"loadSavedRoute(index)\">{{ route.summary }} ({{ route.start }} to {{ route.end }}) - ₹{{ route.cost.toFixed(2) }}</p>\r\n            <input type=\"text\" v-model=\"route.notes\" @blur=\"updateNotes\" placeholder=\"Add/edit notes...\" maxlength=\"100\" />\r\n          </div>\r\n          <button @click=\"deleteRoute(index)\" class=\"delete-btn\" :disabled=\"isDeleting\">\r\n            <span v-if=\"!isDeleting\">Delete</span>\r\n            <span v-else class=\"spinner\"></span>\r\n          </button>\r\n        </div>\r\n      </div> -->\r\n      <template>\r\n        <div id=\"route-planner\">\r\n          <div class=\"map-container\">\r\n            <div id=\"map\"></div>\r\n          </div>\r\n          <div class=\"control-panel\">\r\n            <div class=\"saved-routes\" v-if=\"savedRoutes.length > 0\">\r\n              <h3>Saved Routes</h3>\r\n              <div v-for=\"(route, index) in savedRoutes\" :key=\"index\" class=\"saved-route\">\r\n                <div class=\"saved-route-info\">\r\n                  <p @click=\"loadSavedRoute(index)\">{{ route.summary }} ({{ route.start }} to {{ route.end }}) - {{ route.adjustedDuration.toFixed(1) }} hrs - ₹{{ route.cost.toFixed(2) }}</p>\r\n                  <input type=\"text\" v-model=\"route.notes\" @blur=\"updateNotes\" placeholder=\"Add/edit notes...\" maxlength=\"100\" />\r\n                </div>\r\n                <button @click=\"deleteRoute(index)\" class=\"delete-btn\" :disabled=\"isDeleting\">\r\n                  <span v-if=\"!isDeleting\">Delete</span>\r\n                  <span v-else class=\"spinner\"></span>\r\n                </button>\r\n              </div>\r\n            </div>\r\n      <h2>Plan Your Route</h2>\r\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n      <select v-model=\"vehicle\">\r\n        <option value=\"car\">Car</option>\r\n        <option value=\"truck\">Truck</option>\r\n      </select>\r\n      <select v-model=\"optimization\">\r\n        <option value=\"fastest\">Fastest Route</option>\r\n        <option value=\"shortest\">Shortest Route</option>\r\n        <option value=\"eco\">Least Emissions</option>\r\n      </select>\r\n      <button @click=\"calculateRoute\" :disabled=\"isLoading\">\r\n        <span v-if=\"!isLoading\">Calculate Route</span>\r\n        <span v-else class=\"spinner\"></span>\r\n      </button>\r\n      <input type=\"number\" v-model.number=\"costRate\" step=\"1\" min=\"0\" placeholder=\"Petrol Cost (₹/L)\" class=\"cost-rate-input\" />\r\n      <input type=\"number\" v-model.number=\"timeAdjustment\" step=\"0.1\" placeholder=\"Time Adjust (hrs)\" class=\"time-adjust-input\" />\r\n      <div class=\"routes\" v-if=\"routes.length > 0\">\r\n        <h3>Route Options</h3>\r\n        <div v-for=\"route in routes\" :key=\"route.index\" class=\"route-option\">\r\n          <input type=\"radio\" :value=\"route.index\" v-model=\"selectedRoute\" @change=\"selectRoute\" />\r\n          <label>{{ route.summary }}</label>\r\n          <p>Time: {{ route.duration.toFixed(1) }} hrs | Distance: {{ route.distance.toFixed(1) }} km | CO2: {{ route.co2.toFixed(1) }} kg</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"metrics\" v-if=\"distance > 0\">\r\n        <p>Distance: {{ distance.toFixed(1) }} km</p>\r\n        <p>Time: {{ (routes[selectedRoute].duration + timeAdjustment).toFixed(1) }} hrs (Adjusted)</p>\r\n        <p>Fuel Used: {{ fuelUsed.toFixed(1) }} L</p>\r\n        <p>CO2 Emitted: {{ co2Emitted.toFixed(1) }} kg</p>\r\n        <p>Estimated Cost: ₹{{ (fuelUsed * costRate).toFixed(2) }}</p>\r\n        <input type=\"text\" v-model=\"routeNotes\" placeholder=\"Add route notes...\" maxlength=\"100\" />\r\n        <button @click=\"saveRoute\" :disabled=\"isSaving\">\r\n          <span v-if=\"!isSaving\">Save Route</span>\r\n          <span v-else class=\"spinner\"></span>\r\n        </button>\r\n        <button @click=\"copyShareLink\" :disabled=\"isCopying\">\r\n          <span v-if=\"!isCopying\">Copy Link</span>\r\n          <span v-else class=\"spinner\"></span>\r\n        </button>\r\n      </div>\r\n      <div class=\"weather\" v-if=\"startWeather && endWeather\">\r\n        <h3>Weather Conditions</h3>\r\n        <p>Start: {{ startWeather.weather[0].description }}, {{ startWeather.main.temp }}°C</p>\r\n        <p>End: {{ endWeather.weather[0].description }}, {{ endWeather.main.temp }}°C</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<!-- <template>\r\n  <div id=\"route-planner\">\r\n    <div class=\"map-container\">\r\n      <div id=\"map\"></div>\r\n    </div>\r\n    <div class=\"control-panel\">\r\n      <div class=\"saved-routes\" v-if=\"savedRoutes.length > 0\">\r\n        <h3>Saved Routes</h3>\r\n        <div v-for=\"(route, index) in savedRoutes\" :key=\"index\" class=\"saved-route\">\r\n          <div class=\"saved-route-info\">\r\n            <p @click=\"loadSavedRoute(index)\">{{ route.summary }} ({{ route.start }} to {{ route.end }}) - ₹{{ route.cost.toFixed(2) }}</p>\r\n            <input type=\"text\" v-model=\"route.notes\" @blur=\"updateNotes\" placeholder=\"Add/edit notes...\" maxlength=\"100\" />\r\n          </div>\r\n          <button @click=\"deleteRoute(index)\" class=\"delete-btn\" :disabled=\"isDeleting\">\r\n            <span v-if=\"!isDeleting\">Delete</span>\r\n            <span v-else class=\"spinner\"></span>\r\n          </button>\r\n        </div>\r\n      </div>\r\n      <h2>Plan Your Route</h2>\r\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n      <select v-model=\"vehicle\">\r\n        <option value=\"car\">Car</option>\r\n        <option value=\"truck\">Truck</option>\r\n      </select>\r\n      <select v-model=\"optimization\">\r\n        <option value=\"fastest\">Fastest Route</option>\r\n        <option value=\"shortest\">Shortest Route</option>\r\n        <option value=\"eco\">Least Emissions</option>\r\n      </select>\r\n      <button @click=\"calculateRoute\" :disabled=\"isLoading\">\r\n        <span v-if=\"!isLoading\">Calculate Route</span>\r\n        <span v-else class=\"spinner\"></span>\r\n      </button>\r\n      <input type=\"number\" v-model.number=\"costRate\" step=\"1\" min=\"0\" placeholder=\"Petrol Cost (₹/L)\" class=\"cost-rate-input\" />\r\n      <div class=\"routes\" v-if=\"routes.length > 0\">\r\n        <h3>Route Options</h3>\r\n        <div v-for=\"route in routes\" :key=\"route.index\" class=\"route-option\">\r\n          <input type=\"radio\" :value=\"route.index\" v-model=\"selectedRoute\" @change=\"selectRoute\" />\r\n          <label>{{ route.summary }}</label>\r\n          <p>Time: {{ route.duration.toFixed(1) }} hrs | Distance: {{ route.distance.toFixed(1) }} km | CO2: {{ route.co2.toFixed(1) }} kg</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"metrics\" v-if=\"distance > 0\">\r\n        <p>Distance: {{ distance.toFixed(1) }} km</p>\r\n        <p>Time: {{ routes[selectedRoute].duration.toFixed(1) }} hrs</p>\r\n        <p>Fuel Used: {{ fuelUsed.toFixed(1) }} L</p>\r\n        <p>CO2 Emitted: {{ co2Emitted.toFixed(1) }} kg</p>\r\n        <p>Estimated Cost: ₹{{ (fuelUsed * costRate).toFixed(2) }}</p>\r\n        <input type=\"text\" v-model=\"routeNotes\" placeholder=\"Add route notes...\" maxlength=\"100\" />\r\n        <button @click=\"saveRoute\" :disabled=\"isSaving\">\r\n          <span v-if=\"!isSaving\">Save Route</span>\r\n          <span v-else class=\"spinner\"></span>\r\n        </button>\r\n        <button @click=\"copyShareLink\" :disabled=\"isCopying\">\r\n          <span v-if=\"!isCopying\">Copy Link</span>\r\n          <span v-else class=\"spinner\"></span>\r\n        </button>\r\n      </div>\r\n      <div class=\"weather\" v-if=\"startWeather && endWeather\">\r\n        <h3>Weather Conditions</h3>\r\n        <p>Start: {{ startWeather.weather[0].description }}, {{ startWeather.main.temp }}°C</p>\r\n        <p>End: {{ endWeather.weather[0].description }}, {{ endWeather.main.temp }}°C</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template> -->\r\n\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'RoutePlanner',\r\n  data() {\r\n    return {\r\n      start: '',\r\n      end: '',\r\n      vehicle: 'car',\r\n      optimization: 'fastest',\r\n      map: null,\r\n      directionsService: null,\r\n      directionsRenderer: null,\r\n      distance: 0,\r\n      fuelUsed: 0,\r\n      co2Emitted: 0,\r\n      startWeather: null,\r\n      endWeather: null,\r\n      isLoading: false,\r\n      routes: [],\r\n      selectedRoute: 0,\r\n      savedRoutes: JSON.parse(localStorage.getItem('savedRoutes')) || [],\r\n      isSaving: false,\r\n      isDeleting: false,\r\n      isCopying: false,\r\n      routeNotes: '',\r\n      costRate: 100,\r\n      timeAdjustment: 0,\r\n    };\r\n  },\r\n  mounted() {\r\n    if (this.$google) {\r\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\r\n        center: { lat: 37.7749, lng: -122.4194 },\r\n        zoom: 12,\r\n      });\r\n      const trafficLayer = new this.$google.maps.TrafficLayer();\r\n      trafficLayer.setMap(this.map);\r\n      this.directionsService = new this.$google.maps.DirectionsService();\r\n      this.directionsRenderer = new this.$google.maps.DirectionsRenderer();\r\n      this.directionsRenderer.setMap(this.map);\r\n      this.loadRouteFromUrl();\r\n    } else {\r\n      console.error('Google Maps not loaded yet!');\r\n    }\r\n  },\r\n  methods: {\r\n    async calculateRoute(summaryToMatch = null) {\r\n      if (!this.start || !this.end) {\r\n        alert('Please enter both start and end locations!');\r\n        return;\r\n      }\r\n      this.isLoading = true;\r\n      const request = {\r\n        origin: this.start,\r\n        destination: this.end,\r\n        travelMode: 'DRIVING',\r\n        provideRouteAlternatives: true,\r\n      };\r\n      this.directionsService.route(request, async (result, status) => {\r\n        if (status === 'OK') {\r\n          let tempRoutes = result.routes.map((route, index) => {\r\n            const distance = route.legs[0].distance.value / 1000;\r\n            const duration = route.legs[0].duration.value / 3600;\r\n            const fuelRates = { car: 0.1, truck: 0.3 };\r\n            const co2PerLiter = 2.3;\r\n            const 