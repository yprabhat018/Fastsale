f0;\n}\ninput, select, button {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style>\n\n<!-- <template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // To store the map object\n    };\n  },\n  mounted() {\n    // Wait for Google Maps to load\n    if (window.google) {\n      this.initMap();\n    } else {\n      const checkGoogle = setInterval(() => {\n        if (window.google) {\n          clearInterval(checkGoogle);\n          this.initMap();\n        }\n      }, 100);\n    }\n  },\n  methods: {\n    initMap() {\n      // Create the map once Google is ready\n      this.map = new window.google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    },\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput,\nselect,\nbutton {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style> -->\n<!-- <template>\n  <img alt=\"Vue logo\" src=\"./assets/logo.png\">\n  <HelloWorld msg=\"Welcome to Your Vue.js App\"/>\n</templat