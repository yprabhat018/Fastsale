{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'RoutePlanner',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null,\n      directionsService: null,\n      directionsRenderer: null,\n      distance: 0,\n      fuelUsed: 0,\n      // Fuel in liters\n      co2Emitted: 0 // CO2 in kilograms\n    };\n  },\n  mounted() {\n    if (this.$google) {\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\n        center: {\n          lat: 37.7749,\n          lng: -122.4194\n        },\n        zoom: 12\n      });\n      const trafficLayer = new this.$google.maps.TrafficLayer();\n      trafficLayer.setMap(this.map);\n      this.directionsService = new this.$google.maps.DirectionsService();\n      this.directionsRenderer = new this.$google.maps.DirectionsRenderer();\n      this.directionsRenderer.setMap(this.map);\n    } else {\n      console.error('Google Maps not loaded yet!');\n    }\n  },\n  methods: {\n    calculateRoute() {\n      if (!this.start || !this.end) {\n        alert('Please enter both start and end locations!');\n        return;\n      }\n      const request = {\n        origin: this.start,\n        destination: this.end,\n        travelMode: 'DRIVING',\n        provideRouteAlternatives: true\n      };\n      this.directionsService.route(request, (result, status) => {\n        if (status === 'OK') {\n          this.directionsRenderer.setDirections(result);\n          this.distance = result.routes[0].legs[0].distance.value / 1000;\n\n          // Fuel use (liters per km) and CO2 (kg per liter)\n          const fuelRates = {\n            car: 0.1,\n            truck: 0.3\n          }; // Car: 10L/100km, Truck: 30L/100km\n          const co2PerLiter = 2.3; // Rough average for gasoline/diesel\n          this.fuelUsed = this.distance * fuelRates[this.vehicle];\n          this.co2Emitted = this.fuelUsed * co2PerLiter;\n          console.log('Fuel used:', this.fuelUsed.toFixed(1), 'L');\n          console.log('CO2 emitted:', this.co2Emitted.toFixed(1), 'kg');\n        } else {\n          console.error('Error finding route:', status);\n          alert('Couldn’t find a route. Try different locations!');\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","start","end","vehicle","map","directionsService","directionsRenderer","distance","fuelUsed","co2Emitted","mounted","$google","maps","Map","document","getElementById","center","lat","lng","zoom","trafficLayer","TrafficLayer","setMap","DirectionsService","DirectionsRenderer","console","error","methods","calculateRoute","alert","request","origin","destination","travelMode","provideRouteAlternatives","route","result","status","setDirections","routes","legs","value","fuelRates","car","truck","co2PerLiter","log","toFixed"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\views\\RoutePlanner.vue"],"sourcesContent":["<template>\r\n    <div id=\"route-planner\">\r\n      <div class=\"map-container\">\r\n        <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\r\n      </div>\r\n      <div class=\"control-panel\">\r\n        <h2>Plan Your Route</h2>\r\n        <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n        <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n        <select v-model=\"vehicle\">\r\n          <option value=\"car\">Car</option>\r\n          <option value=\"truck\">Truck</option>\r\n        </select>\r\n        <button @click=\"calculateRoute\">Calculate Route</button>\r\n        <div class=\"metrics\" v-if=\"distance > 0\">\r\n          <p>Distance: {{ distance.toFixed(1) }} km</p>\r\n          <p>Fuel Used: {{ fuelUsed.toFixed(1) }} L</p>\r\n          <p>CO2 Emitted: {{ co2Emitted.toFixed(1) }} kg</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n\r\n  <script>\r\n  export default {\r\n    name: 'RoutePlanner',\r\n    data() {\r\n      return {\r\n        start: '',\r\n        end: '',\r\n        vehicle: 'car',\r\n        map: null,\r\n        directionsService: null,\r\n        directionsRenderer: null,\r\n        distance: 0,\r\n        fuelUsed: 0, // Fuel in liters\r\n        co2Emitted: 0, // CO2 in kilograms\r\n      };\r\n    },\r\n    mounted() {\r\n      if (this.$google) {\r\n        this.map = new this.$google.maps.Map(document.getElementById('map'), {\r\n          center: { lat: 37.7749, lng: -122.4194 },\r\n          zoom: 12,\r\n        });\r\n        const trafficLayer = new this.$google.maps.TrafficLayer();\r\n        trafficLayer.setMap(this.map);\r\n        this.directionsService = new this.$google.maps.DirectionsService();\r\n        this.directionsRenderer = new this.$google.maps.DirectionsRenderer();\r\n        this.directionsRenderer.setMap(this.map);\r\n      } else {\r\n        console.error('Google Maps not loaded yet!');\r\n      }\r\n    },\r\n    methods: {\r\n      calculateRoute() {\r\n        if (!this.start || !this.end) {\r\n          alert('Please enter both start and end locations!');\r\n          return;\r\n        }\r\n        const request = {\r\n          origin: this.start,\r\n          destination: this.end,\r\n          travelMode: 'DRIVING',\r\n          provideRouteAlternatives: true,\r\n        };\r\n        this.directionsService.route(request, (result, status) => {\r\n          if (status === 'OK') {\r\n            this.directionsRenderer.setDirections(result);\r\n            this.distance = result.routes[0].legs[0].distance.value / 1000;\r\n  \r\n            // Fuel use (liters per km) and CO2 (kg per liter)\r\n            const fuelRates = { car: 0.1, truck: 0.3 }; // Car: 10L/100km, Truck: 30L/100km\r\n            const co2PerLiter = 2.3; // Rough average for gasoline/diesel\r\n            this.fuelUsed = this.distance * fuelRates[this.vehicle];\r\n            this.co2Emitted = this.fuelUsed * co2PerLiter;\r\n  \r\n            console.log('Fuel used:', this.fuelUsed.toFixed(1), 'L');\r\n            console.log('CO2 emitted:', this.co2Emitted.toFixed(1), 'kg');\r\n          } else {\r\n            console.error('Error finding route:', status);\r\n            alert('Couldn’t find a route. Try different locations!');\r\n          }\r\n        });\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  <style>\r\n  #route-planner {\r\n    display: flex;\r\n  }\r\n  .map-container {\r\n    flex: 7;\r\n  }\r\n  .control-panel {\r\n    flex: 3;\r\n    padding: 20px;\r\n    background-color: #f0f0f0;\r\n  }\r\n  input,\r\n  select,\r\n  button {\r\n    width: 100%;\r\n    margin: 10px 0;\r\n    padding: 10px;\r\n  }\r\n  .metrics {\r\n    margin-top: 20px;\r\n    background-color: #e0e0e0;\r\n    padding: 10px;\r\n    border-radius: 5px;\r\n  }\r\n  .metrics p {\r\n    margin: 5px 0;\r\n  }\r\n\r\n  \r\n  </style>\r\n  <!-- <style>\r\n  #route-planner {\r\n    display: flex;\r\n  }\r\n  .map-container {\r\n    flex: 7;\r\n  }\r\n  .control-panel {\r\n    flex: 3;\r\n    padding: 20px;\r\n    background-color: #f0f0f0;\r\n  }\r\n  input,\r\n  select,\r\n  button {\r\n    width: 100%;\r\n    margin: 10px 0;\r\n    padding: 10px;\r\n  }\r\n  </style> -->"],"mappings":";;AAwBE,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,GAAG,EAAE,EAAE;MACPC,OAAO,EAAE,KAAK;MACdC,GAAG,EAAE,IAAI;MACTC,iBAAiB,EAAE,IAAI;MACvBC,kBAAkB,EAAE,IAAI;MACxBC,QAAQ,EAAE,CAAC;MACXC,QAAQ,EAAE,CAAC;MAAE;MACbC,UAAU,EAAE,CAAC,CAAE;IACjB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,IAAI,CAACC,OAAO,EAAE;MAChB,IAAI,CAACP,GAAE,GAAI,IAAI,IAAI,CAACO,OAAO,CAACC,IAAI,CAACC,GAAG,CAACC,QAAQ,CAACC,cAAc,CAAC,KAAK,CAAC,EAAE;QACnEC,MAAM,EAAE;UAAEC,GAAG,EAAE,OAAO;UAAEC,GAAG,EAAE,CAAC;QAAS,CAAC;QACxCC,IAAI,EAAE;MACR,CAAC,CAAC;MACF,MAAMC,YAAW,GAAI,IAAI,IAAI,CAACT,OAAO,CAACC,IAAI,CAACS,YAAY,CAAC,CAAC;MACzDD,YAAY,CAACE,MAAM,CAAC,IAAI,CAAClB,GAAG,CAAC;MAC7B,IAAI,CAACC,iBAAgB,GAAI,IAAI,IAAI