og('Google Maps API loaded, initializing map...');\r\n        this.map = new this.$google.maps.Map(document.getElementById('map'), {\r\n          center: { lat: 37.7749, lng: -122.4194 },\r\n          zoom: 12,\r\n        });\r\n        this.loadAlerts();\r\n      } else {\r\n        console.error('Google Maps API not loaded!');\r\n      }\r\n    },\r\n    methods: {\r\n      loadAlerts() {\r\n        console.log('Loading alerts...');\r\n        this.alerts = JSON.parse(localStorage.getItem('alerts')) || [];\r\n        this.displayAlertsOnMap();\r\n      },\r\n  \r\n      reportIssue() {\r\n  console.log('Report Issue clicked!');\r\n  try {\r\n    const newAlert = {\r\n      id: this.alerts.length + 1,\r\n      type: 'Accident',\r\n      location: { lat: 37.7749, lng: -122.4194 },\r\n      timestamp: new Date(),\r\n    };\r\n    this.alerts.push(newAlert);\r\n    console.log('New alert added:', newAlert);\r\n    localStorage.setItem('alerts', JSON.stringify(this.alerts));\r\n    this.displayAlertsOnMap();\r\n  } catch (error) {\r\n    console.error('Error in reportIssue:', error);\r\n  }\r\n},\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .crowdsourced-alerts {\r\n    padding: 20px;\r\n    background-color: #fff0f5;\r\n    min-height: 100vh;\r\n  }\r\n  h2 {\r\n    color: #333;\r\n    margin-bottom: 10px;\r\n  }\r\n  #map {\r\n    height: 400px;\r\n    width: 100%;\r\n    border: 1px solid #ccc;\r\n    margin-bottom: 10px;\r\n  }\r\n  button {\r\n    padding: 8px 16px;\r\n    background-color: #ff5722;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 3px;\r\n    cursor: pointer;\r\n  }\r\n  button:hover {\r\n    background-color: #e64a19;\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAqB;;uBAAhCC,mBAAA,CAOM,OAPNC,UAOM,G,0BANJC,mBAAA,CAAqC,YAAjC,8BAA4B,sB,0BAChCA,mBAAA,CAAoB;IAAfC,EAAE,EAAC;EAAK,6BACbC,mBAAA,0DAA2D,EAC3DF,mBAAA,CAAkD;IAAzCG,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,WAAA,IAAAD,QAAA,CAAAC,WAAA,IAAA