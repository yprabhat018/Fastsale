{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'RoutePlanner',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null,\n      directionsService: null,\n      directionsRenderer: null\n    };\n  },\n  mounted() {\n    if (this.$google) {\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\n        center: {\n          lat: 37.7749,\n          lng: -122.4194\n        },\n        zoom: 12\n      });\n      this.directionsService = new this.$google.maps.DirectionsService();\n      this.directionsRenderer = new this.$google.maps.DirectionsRenderer();\n      this.directionsRenderer.setMap(this.map);\n    } else {\n      console.error('Google Maps not loaded yet!');\n    }\n  },\n  methods: {\n    calculateRoute() {\n      if (!this.start || !this.end) {\n        alert('Please enter both start and end locations!');\n        return;\n      }\n      const request = {\n        origin: this.start,\n        destination: this.end,\n        travelMode: 'DRIVING'\n      };\n      this.directionsService.route(request, (result, status) => {\n        if (status === 'OK') {\n          this.directionsRenderer.setDirections(result);\n          console.log('Route drawn successfully!');\n        } else {\n          console.error('Error finding route:', status);\n          alert('Couldn’t find a route. Try different locations!');\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","start","end","vehicle","map","directionsService","directionsRenderer","mounted","$google","maps","Map","document","getElementById","center","lat","lng","zoom","DirectionsService","DirectionsRenderer","setMap","console","error","methods","calculateRoute","alert","request","origin","destination","travelMode","route","result","status","setDirections","log"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\views\\RoutePlanner.vue"],"sourcesContent":["<template>\r\n    <div id=\"route-planner\">\r\n      <div class=\"map-container\">\r\n        <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\r\n      </div>\r\n      <div class=\"control-panel\">\r\n        <h2>Plan Your Route</h2>\r\n        <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n        <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n        <select v-model=\"vehicle\">\r\n          <option value=\"car\">Car</option>\r\n          <option value=\"truck\">Truck</option>\r\n        </select>\r\n        <button @click=\"calculateRoute\">Calculate Route</button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: 'RoutePlanner',\r\n    data() {\r\n      return {\r\n        start: '',\r\n        end: '',\r\n        vehicle: 'car',\r\n        map: null,\r\n        directionsService: null,\r\n        directionsRenderer: null,\r\n      };\r\n    },\r\n    mounted() {\r\n      if (this.$google) {\r\n        this.map = new this.$google.maps.Map(document.getElementById('map'), {\r\n          center: { lat: 37.7749, lng: -122.4194 },\r\n          zoom: 12,\r\n        });\r\n        this.directionsService = new this.$google.maps.DirectionsService();\r\n        this.directionsRenderer = new this.$google.maps.DirectionsRenderer();\r\n        this.directionsRenderer.setMap(this.map);\r\n      } else {\r\n        console.error('Google Maps not loaded yet!');\r\n      }\r\n    },\r\n    methods: {\r\n      calculateRoute() {\r\n        if (!this.start || !this.end) {\r\n          alert('Please enter both start and end locations!');\r\n          return;\r\n        }\r\n        const request = {\r\n          origin: this.start,\r\n          destination: this.end,\r\n          travelMode: 'DRIVING',\r\n        };\r\n        this.directionsService.route(request, (result, status) => {\r\n          if (status === 'OK') {\r\n            this.directionsRenderer.setDirections(result);\r\n            console.log('Route drawn successfully!');\r\n          } else {\r\n            console.error('Error finding route:', status);\r\n            alert('Couldn’t find a route. Try different locations!');\r\n          }\r\n        });\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style>\r\n  #route-planner {\r\n    display: flex;\r\n  }\r\n  .map-container {\r\n    flex: 7;\r\n  }\r\n  .control-panel {\r\n    flex: 3;\r\n    padding: 20px;\r\n    background-color: #f0f0f0;\r\n  }\r\n  input,\r\n  select,\r\n  button {\r\n    width: 100%;\r\n    margin: 10px 0;\r\n    padding: 10px;\r\n  }\r\n  </style>"],"mappings":";;AAmBE,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,GAAG,EAAE,EAAE;MACPC,OAAO,EAAE,KAAK;MACdC,GAAG,EAAE,IAAI;MACTC,iBAAiB,EAAE,IAAI;MACvBC,kBAAkB,EAAE;IACtB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,IAAI,CAACC,OAAO,EAAE;MAChB,IAAI,CAACJ,GAAE,GAAI,IAAI,IAAI,CAACI,OAAO,CAACC,IAAI,CAACC,GAAG,CAACC,QAAQ,CAACC,cAAc,CAAC,KAAK,CAAC,EAAE;QACnEC,MAAM,EAAE;UAAEC,GAAG,EAAE,OAAO;UAAEC,GAAG,EAAE,CAAC;QAAS,CAAC;QACxCC,IAAI,EAAE;MACR,CAAC,CAAC;MACF,IAAI,CAACX,iBAAgB,GAAI,IAAI,IAAI,CAACG,OAAO,CAACC,IAAI,CAACQ,iBAAiB,CAAC,CAAC;MAClE,IAAI,CAACX,kBAAiB,GAAI,IAAI,IAAI,CAACE,OAAO,CAACC,IAAI,CAACS,kBAAkB,CAAC,CAAC;MACpE,IAAI,CAACZ,kBAAkB,CAACa,MAAM,CAAC,IAAI,CAACf,GAAG,CAAC;IAC1C,OAAO;MACLgB,OAAO,CAACC,KAAK,CAAC,6BAA6B,CAAC;IAC9C;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,cAAcA,CAAA,EAAG;MACf,IAAI,CAAC,IAAI,CAACtB,KAAI,IAAK,CAAC,IAAI,CAACC,GAAG,EAAE;QAC5BsB,KAAK,CAAC,4CAA4C,CAAC;QACnD;MACF;MACA,MAAMC,OAAM,GAAI;QACdC,MAAM,EAAE,IAAI,CAACzB,KAAK;QAClB0B,WAAW,EAAE,IAAI,CAACzB,GAAG;QACrB0B,UAAU,EAAE;MACd,CAAC;MACD,IAAI,CAACvB,iBAAiB,CAACwB,KAAK,CAACJ,OAAO,EAAE,CAACK,MAAM,EAAEC,MAAM,KAAK;QACxD,IAAIA,MAAK,KAAM,IAAI,EAAE;UACnB,IAAI,CAACzB,kBAAkB,CAAC0B,aAAa,CAACF,MAAM,CAAC;UAC7CV,OAAO,CAACa,GAAG,CAAC,2BAA2B,CAAC;QAC1C,OAAO;UACLb,OAAO,CAACC,KAAK,CAAC,sBAAsB,EAAEU,MAAM,CAAC;UAC