ing',\r\n            location: 'Warehouse',\r\n          });\r\n          this.newOrder = '';\r\n        }\r\n      },\r\n      updateOrderStatus(index) {\r\n        const currentStatusIndex = this.statuses.indexOf(this.orders[index].status);\r\n        const nextStatusIndex = (currentStatusIndex + 1) % this.statuses.length;\r\n        this.orders[index].status = this.statuses[nextStatusIndex];\r\n        this.orders[index].location = this.locations[nextStatusIndex];\r\n      },\r\n      removeOrder(index) {\r\n        this.orders.splice(index, 1);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .shipping-tracking {\r\n    padding: 20px;\r\n    background-color: #f0f8ff;\r\n    min-height: 100vh;\r\n  }\r\n  h2 {\r\n    color: #333;\r\n  }\r\n  .tracking-section {\r\n    margin-top: 20px;\r\n  }\r\n  h3 {\r\n    font-size: 18px;\r\n    color: #555;\r\n    margin-bottom: 10px;\r\n  }\r\n  input {\r\n    width: 200px;\r\n    padding: 5px;\r\n    margin-bottom: 10px;\r\n  }\r\n  ul {\r\n    list-style: none;\r\n    padding: 0;\r\n  }\r\n  li {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin: 5px 0;\r\n  }\r\n  button {\r\n    padding: 5px 10px;\r\n    background-color: #007bff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 3px;\r\n    cursor: pointer;\r\n  }\r\n  button:hover {\r\n    background-color: #0056b3;\r\n  }\r\n  button:nth-child(2) {\r\n    background-color: #ff4d4d;\r\n  }\r\n  button:nth-child(2):hover {\r\n    background-color: #e60000;\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAmB;;EAEvBA,KAAK,EAAC;AAAkB;mBAHnC;mBAAA;;uBACIC,mBAAA,CAaM,OAbNC,UAaM,G,0BAZJC,mBAAA,CAA0B,YAAtB,mBAAiB,sBACrBA,mBAAA,CAUM,OAVNC,UAUM,G,0BATJD,mBAAA,CAAwB,YAApB,iBAAe,sB,gBACnBA,mBAAA,CAA8F;IALtG,uBAAAE,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAKwBC,KAAA,CAAAC,QAAQ,GAAAF,MAAA;IAAEG,WAAW,EAAC,6BAA6B;IAAEC,OAAK,EAAAL,MAAA,QAAAA,MAAA,MALlFM,SAAA,KAAAC,IAAA,KAK0FC,QAAA,CAAAC,QAAA,IAAAD,QAAA,CAAAC,QAAA,IAAA