{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null // To store the map object\n    };\n  },\n  mounted() {\n    // Wait for Google Maps to load\n    if (window.google) {\n      this.initMap();\n    } else {\n      // If Google Maps isn’t loaded yet, wait for it\n      const checkGoogle = setInterval(() => {\n        if (window.google) {\n          clearInterval(checkGoogle);\n          this.initMap();\n        }\n      }, 100);\n    }\n  },\n  methods: {\n    initMap() {\n      // Create the map once Google is ready\n      this.map = new window.google.maps.Map(document.getElementById('map'), {\n        center: {\n          lat: 37.7749,\n          lng: -122.4194\n        },\n        // San Francisco\n        zoom: 12\n      });\n    },\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    }\n  }\n};","map":{"version":3,"names":["name","data","start","end","vehicle","map","mounted","window","google","initMap","checkGoogle","setInterval","clearInterval","methods","maps","Map","document","getElementById","center","lat","lng","zoom","calculateRoute","console","log"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <div class=\"map-container\">\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\n    </div>\n    <div class=\"control-panel\">\n      <h2>Plan Your Route</h2>\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\n      <select v-model=\"vehicle\">\n        <option value=\"car\">Car</option>\n        <option value=\"truck\">Truck</option>\n      </select>\n      <button @click=\"calculateRoute\">Calculate Route</button>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      start: '',\n      end: '',\n      vehicle: 'car',\n      map: null, // To store the map object\n    };\n  },\n  mounted() {\n    // Wait for Google Maps to load\n    if (window.google) {\n      this.initMap();\n    } else {\n      // If Google Maps isn’t loaded yet, wait for it\n      const checkGoogle = setInterval(() => {\n        if (window.google) {\n          clearInterval(checkGoogle);\n          this.initMap();\n        }\n      }, 100);\n    }\n  },\n  methods: {\n    initMap() {\n      // Create the map once Google is ready\n      this.map = new window.google.maps.Map(document.getElementById('map'), {\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\n        zoom: 12,\n      });\n    },\n    calculateRoute() {\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\n    },\n  },\n};\n</script>\n\n<style>\n#app {\n  display: flex;\n}\n.map-container {\n  flex: 7;\n}\n.control-panel {\n  flex: 3;\n  padding: 20px;\n  background-color: #f0f0f0;\n}\ninput,\nselect,\nbutton {\n  width: 100%;\n  margin: 10px 0;\n  padding: 10px;\n}\n</style>\n<!-- <template>\n  <img alt=\"Vue logo\" src=\"./assets/logo.png\">\n  <HelloWorld msg=\"Welcome to Your Vue.js App\"/>\n</template>\n\n<script>\nimport HelloWorld from './components/HelloWorld.vue'\n\nexport default {\n  name: 'App',\n  components: {\n    HelloWorld\n  }\n}\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n</style> -->\n"],"mappings":";;AAmBA,eAAe;EACbA,IAAI,EAAE,KAAK;EACXC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,GAAG,EAAE,EAAE;MACPC,OAAO,EAAE,KAAK;MACdC,GAAG,EAAE,IAAI,CAAE;IACb,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,IAAIC,MA