{"ast":null,"code":"import { resolveComponent as _resolveComponent, createVNode as _createVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  id: \"app\"\n};\nexport function render(_ctx, _cache) {\n  const _component_router_view = _resolveComponent(\"router-view\");\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createVNode(_component_router_view)]);\n}","map":{"version":3,"names":["id","_createElementBlock","_hoisted_1","_createVNode","_component_router_view"],"sources":["C:\\Users\\sandh\\logistics-app\\src\\App.vue"],"sourcesContent":["<template>\r\n  <div id=\"app\">\r\n    <router-view></router-view>\r\n  </div>\r\n</template>\r\n\r\n<!-- <script>\r\nexport default {\r\n  plugins: [\r\n  name: 'App',\r\n    // Could be vue-google-maps or similar\r\n  ],\r\n}; -->\r\n<script>\r\nexport default {\r\n  pulgins: [\r\n  name: 'App',\r\n  mounted() {\r\n    const script = document.createElement('script');\r\n    script.src = 'https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places';\r\n    script.async = true;\r\n    script.onload = () => console.log('Google Maps loaded!');\r\n    script.onerror = () => console.error('Failed to load Google Maps');\r\n    document.head.appendChild(script);\r\n  },\r\n],\r\n};\r\n</script>\r\n\r\n\r\n<style>\r\n#app {\r\n  font-family: Avenir, Helvetica, Arial, sans-serif;\r\n}\r\n</style>\r\n\r\n<!-- <template>\r\n  <div id=\"app\">\r\n    <div class=\"map-container\">\r\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\r\n    </div>\r\n    <div class=\"control-panel\">\r\n      <h2>Plan Your Route</h2>\r\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n      <select v-model=\"vehicle\">\r\n        <option value=\"car\">Car</option>\r\n        <option value=\"truck\">Truck</option>\r\n      </select>\r\n      <button @click=\"calculateRoute\">Calculate Route</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'App',\r\n  data() {\r\n    return {\r\n      start: '',\r\n      end: '',\r\n      vehicle: 'car',\r\n      map: null, // Store the map\r\n      directionsService: null, // To calculate routes\r\n      directionsRenderer: null, // To draw routes\r\n    };\r\n  },\r\n  mounted() {\r\n    if (this.$google) {\r\n      // Set up the map\r\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\r\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\r\n        zoom: 12,\r\n      });\r\n      // Set up Directions Service and Renderer\r\n      this.directionsService = new this.$google.maps.DirectionsService();\r\n      this.directionsRenderer = new this.$google.maps.DirectionsRenderer();\r\n      this.directionsRenderer.setMap(this.map); // Link renderer to the map\r\n    } else {\r\n      console.error('Google Maps not loaded yet!');\r\n    }\r\n  },\r\n  methods: {\r\n    calculateRoute() {\r\n      if (!this.start || !this.end) {\r\n        alert('Please enter both start and end locations!');\r\n        return;\r\n      }\r\n\r\n      // Create a request for the Directions Service\r\n      const request = {\r\n        origin: this.start,\r\n        destination: this.end,\r\n        travelMode: 'DRIVING', // We’ll tweak this based on vehicle later\r\n      };\r\n\r\n      // Use Directions Service to get the route\r\n      this.directionsService.route(request, (result, status) => {\r\n        if (status === 'OK') {\r\n          // Draw the route on the map\r\n          this.directionsRenderer.setDirections(result);\r\n          console.log('Route drawn successfully!');\r\n        } else {\r\n          console.error('Error finding route:', status);\r\n          alert('Couldn’t find a route. Try different locations!');\r\n        }\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  display: flex;\r\n}\r\n.map-container {\r\n  flex: 7;\r\n}\r\n.control-panel {\r\n  flex: 3;\r\n  padding: 20px;\r\n  background-color: #f0f0f0;\r\n}\r\ninput,\r\nselect,\r\nbutton {\r\n  width: 100%;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n}\r\n</style> -->\r\n\r\n<!-- <template>\r\n  <div id=\"app\">\r\n    <div class=\"map-container\">\r\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\r\n    </div>\r\n    <div class=\"control-panel\">\r\n      <h2>Plan Your Route</h2>\r\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n      <select v-model=\"vehicle\">\r\n        <option value=\"car\">Car</option>\r\n        <option value=\"truck\">Truck</option>\r\n      </select>\r\n      <button @click=\"calculateRoute\">Calculate Route</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'App',\r\n  data() {\r\n    return {\r\n      start: '',\r\n      end: '',\r\n      vehicle: 'car',\r\n      map: null, // To store the map object\r\n    };\r\n  },\r\n  mounted() {\r\n    // Use the global $google object\r\n    if (this.$google) {\r\n      this.map = new this.$google.maps.Map(document.getElementById('map'), {\r\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\r\n        zoom: 12,\r\n      });\r\n    } else {\r\n      console.error('Google Maps not loaded yet!');\r\n    }\r\n  },\r\n  methods: {\r\n    calculateRoute() {\r\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  display: flex;\r\n}\r\n.map-container {\r\n  flex: 7;\r\n}\r\n.control-panel {\r\n  flex: 3;\r\n  padding: 20px;\r\n  background-color: #f0f0f0;\r\n}\r\ninput, select, button {\r\n  width: 100%;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n}\r\n</style> -->\r\n<!-- <template>\r\n  <div id=\"app\">\r\n    <div class=\"map-container\">\r\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\r\n    </div>\r\n    <div class=\"control-panel\">\r\n      <h2>Plan Your Route</h2>\r\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n      <select v-model=\"vehicle\">\r\n        <option value=\"car\">Car</option>\r\n        <option value=\"truck\">Truck</option>\r\n      </select>\r\n      <button @click=\"calculateRoute\">Calculate Route</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Loader } from '@googlemaps/js-api-loader';\r\n\r\nexport default {\r\n  name: 'App',\r\n  data() {\r\n    return {\r\n      start: '',\r\n      end: '',\r\n      vehicle: 'car',\r\n      map: null, // Store the map here\r\n    };\r\n  },\r\n  mounted() {\r\n    // Load Google Maps when the component mounts\r\n    const loader = new Loader({\r\n      apiKey: 'AIzaSyCOrCd4askrLzy3Ml2LGzsX1a1pHmuLC6k', // Replace with your Google Maps API key\r\n      version: 'weekly',\r\n      libraries: ['places'],\r\n    });\r\n\r\n    loader.load().then(() => {\r\n      console.log('Google Maps loaded in App.vue');\r\n      this.map = new google.maps.Map(document.getElementById('map'), {\r\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\r\n        zoom: 12,\r\n      });\r\n    }).catch(error => {\r\n      console.error('Error loading Google Maps:', error);\r\n    });\r\n  },\r\n  methods: {\r\n    calculateRoute() {\r\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  display: flex;\r\n}\r\n.map-container {\r\n  flex: 7;\r\n}\r\n.control-panel {\r\n  flex: 3;\r\n  padding: 20px;\r\n  background-color: #f0f0f0;\r\n}\r\ninput, select, button {\r\n  width: 100%;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n}\r\n</style> -->\r\n<!-- \r\n\r\n<template>\r\n  <div id=\"app\">\r\n    <h1>Hello, Logistics App!</h1>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'App',\r\n};\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  font-family: Avenir, Helvetica, Arial, sans-serif;\r\n  text-align: center;\r\n}\r\n</style> --> \r\n\r\n<!-- <template>\r\n  <div id=\"app\">\r\n    <div class=\"map-container\">\r\n      <div id=\"map\" style=\"width: 100%; height: 100vh;\"></div>\r\n    </div>\r\n    <div class=\"control-panel\">\r\n      <h2>Plan Your Route</h2>\r\n      <input type=\"text\" v-model=\"start\" placeholder=\"Start Location\" />\r\n      <input type=\"text\" v-model=\"end\" placeholder=\"End Location\" />\r\n      <select v-model=\"vehicle\">\r\n        <option value=\"car\">Car</option>\r\n        <option value=\"truck\">Truck</option>\r\n      </select>\r\n      <button @click=\"calculateRoute\">Calculate Route</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'App',\r\n  data() {\r\n    return {\r\n      start: '',\r\n      end: '',\r\n      vehicle: 'car',\r\n      map: null, // To store the map object\r\n    };\r\n  },\r\n  mounted() {\r\n    // Wait for Google Maps to load\r\n    if (window.google) {\r\n      this.initMap();\r\n    } else {\r\n      const checkGoogle = setInterval(() => {\r\n        if (window.google) {\r\n          clearInterval(checkGoogle);\r\n          this.initMap();\r\n        }\r\n      }, 100);\r\n    }\r\n  },\r\n  methods: {\r\n    initMap() {\r\n      // Create the map once Google is ready\r\n      this.map = new window.google.maps.Map(document.getElementById('map'), {\r\n        center: { lat: 37.7749, lng: -122.4194 }, // San Francisco\r\n        zoom: 12,\r\n      });\r\n    },\r\n    calculateRoute() {\r\n      console.log('Calculating route from', this.start, 'to', this.end, 'with', this.vehicle);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  display: flex;\r\n}\r\n.map-container {\r\n  flex: 7;\r\n}\r\n.control-panel {\r\n  flex: 3;\r\n  padding: 20px;\r\n  background-color: #f0f0f0;\r\n}\r\ninput,\r\nselect,\r\nbutton {\r\n  width: 100%;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n}\r\n</style>  -->\r\n<!-- <template>\r\n  <img alt=\"Vue logo\" src=\"./assets/logo.png\">\r\n  <HelloWorld msg=\"Welcome to Your Vue.js App\"/>\r\n</template>\r\n\r\n<script>\r\nimport HelloWorld from './components/HelloWorld.vue'\r\n\r\nexport default {\r\n  name: 'App',\r\n  components: {\r\n    HelloWorld\r\n  }\r\n}\r\n</script>\r\n\r\n<style>\r\n#app {\r\n  font-family: Avenir, Helvetica, Arial, sans-serif;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  text-align: center;\r\n  color: #2c3e50;\r\n  margin-top: 60px;\r\n}\r\n</style>-->\r\n"],"mappings":";;EACOA,EAAE,EAAC;AAAK;;;uBAAbC,mBAAA,CAEM,OAFNC,UAEM,GADJC,YAAA,CAA2BC,sBAAA,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}